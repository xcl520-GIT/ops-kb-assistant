# ============================================================
#  配置模板
#  使用方式：复制本文件为 .env，然后填入你自己的 API Key
#      copy .env.example .env
# ============================================================

# ---------- 大模型服务（兼容 OpenAI 协议）----------
DEEPSEEK_API_KEY=sk-替换成你自己的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-chat
TEMPERATURE=0.3
MAX_TOKENS=2048
LLM_TIMEOUT=180
# 带入模型的历史对话轮数
HISTORY_TURNS=6

# ---------- 知识库 ----------
# 相对路径相对于本项目根目录解析；也可以填绝对路径
KB_DIR=./kb
# 每次问答召回的片段数
TOP_K=5
# 命中阈值：低于它认为「知识库未覆盖」，转联网检索（0~1）
KB_SCORE_THRESHOLD=0.5
# 送进模型的上下文最大字符数
MAX_CONTEXT_CHARS=9000

# ---------- 联网检索 ----------
WEB_SEARCH_ENABLED=true
# 搜索引擎优先级。注意：Google / DuckDuckGo 在部分网络环境下不可达
WEB_ENGINES=bing,baidu
WEB_MAX_PAGES=3
WEB_TIMEOUT=15
WEB_MAX_CHARS=6000

# ---------- 知识库回写 ----------
# off = 不回写 / inbox = 写入 _inbox 待审核区（推荐） / auto = 直接入库（不推荐）
AUTO_INGEST=inbox

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8765
